# ---------- LLM (any OpenAI-compatible endpoint) ----------
# Options: gemini | openai | groq | openrouter | custom | mock
LLM_PROVIDER=gemini
LLM_API_KEY=your_key_here
# Optional: models to try first, comma separated. If one is retired / out of quota the app
# falls back to the next, then to the provider's built-in chain, then auto-discovers via /models.
# LLM_MODELS=gemini-3.8-flash,gemini-3-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_CONCURRENCY=4

# ---------- Scraping (Apify) ----------
# SCRAPER=apify uses the actors below. SCRAPER=mock only works with the fictional sample data.
SCRAPER=apify
APIFY_TOKEN=your_apify_token_here
INSTAGRAM_ACTOR=apify/instagram-profile-scraper
# Scraped profiles are reused for this many days before a fresh scrape ("Refresh data" bypasses it)
SCRAPE_CACHE_DAYS=7
LINKEDIN_ACTOR=harvestapi/linkedin-profile-scraper

# ---------- Agents ----------
# messages per date (both agents combined)
DATE_TURNS=8
# how many candidates each agent shortlists for real dates
SHORTLIST_K=4

# ---------- Server ----------
PORT=3000
# If set, deleting people / resetting data requires this token (x-admin-token header)
ADMIN_TOKEN=
